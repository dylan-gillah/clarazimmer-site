---
// Film stills / behind-the-scenes grid. Stills keep the frame's own shape (taken from the first
// image); behind-the-scenes photos are cropped to one shape so mixed phone photos line up.
import Img from './Img.astro';
import { original } from '../lib/images';

interface Props {
  photos: string[];
  alt: (n: number) => string;
  columns: 2 | 3;
  /** CSS aspect-ratio for every cell; defaults to the first photo's own ratio. */
  aspect?: string;
}
const { photos, alt, columns, aspect } = Astro.props;
const first = original(photos[0]);
const ratio = aspect ?? `${first.width} / ${first.height}`;
const sizes = columns === 2 ? '(max-width: 700px) 100vw, 502px' : '(max-width: 700px) 100vw, 335px';
---
<div class:list={['gallery', `cols-${columns}`]} style={`--ratio:${ratio}`}>
  {photos.map((p, i) => (
    <div class="cell"><Img path={p} alt={alt(i + 1)} sizes={sizes} /></div>
  ))}
</div>
<style>
  .gallery{display:grid;gap:1px;background:rgba(255,255,255,.04)}
  .cols-2{grid-template-columns:repeat(2,1fr)}
  .cols-3{grid-template-columns:repeat(3,1fr)}
  .cell{overflow:hidden;aspect-ratio:var(--ratio)}
  .cell :global(img){width:100%;height:100%;object-fit:cover;filter:grayscale(30%);transition:transform .9s var(--ease-out-expo),filter .6s ease}
  .cell:hover :global(img){transform:scale(1.04);filter:grayscale(0%)}
  @media (max-width:700px){.cols-2,.cols-3{grid-template-columns:1fr}}
</style>
